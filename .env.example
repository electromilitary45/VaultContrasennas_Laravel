APP_NAME="PassVault"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# ============================================
# CONFIGURACIÓN DEL SISTEMA
# ============================================
# NOTA: Las siguientes configuraciones pueden gestionarse desde el Panel de Administración
# (Admin > Configuración del Sistema) una vez que el sistema esté en funcionamiento:
# - APP_NAME: Nombre de la aplicación
# - APP_URL: URL de la aplicación
# - APP_TIMEZONE: Zona horaria (ver más abajo)
# - APP_LOCALE: Idioma (es, en)
# - Configuración de Email/SMTP (MAIL_*)
# - Políticas de seguridad (longitud de contraseña, etc.)
# - Modo de mantenimiento
#
# Estas variables sirven como valores por defecto iniciales.
# Una vez guardadas en el panel de admin, se almacenan en la base de datos.
# ============================================

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Mexico_City

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# BASE DE DATOS
# ============================================
# IMPORTANTE: Estas configuraciones NO se pueden cambiar desde el panel de admin
# por razones de seguridad. Deben configurarse aquí.
# ============================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vault_contrasenna
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# SESIONES
# ============================================
# SESSION_LIFETIME puede gestionarse desde el panel de admin (Políticas de Seguridad)
# pero este valor sirve como valor por defecto inicial.
# ============================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ============================================
# LARAVEL REVERB (WebSockets)
# ============================================
# Configuración para notificaciones en tiempo real
# Generar valores aleatorios seguros de 32 caracteres para:
# - REVERB_APP_ID
# - REVERB_APP_KEY
# - REVERB_APP_SECRET
# 
# Para desarrollo local, usar:
# - REVERB_HOST=localhost
# - REVERB_PORT=8080
# - REVERB_SCHEME=http
# 
# Para producción, ajustar según tu servidor.
# ============================================

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Variables para Vite (frontend)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# CONFIGURACIÓN DE EMAIL/SMTP
# ============================================
# NOTA: Estas configuraciones pueden gestionarse desde el Panel de Administración
# (Admin > Configuración del Sistema > Email/SMTP)
# 
# IMPORTANTE: La contraseña de email se almacena cifrada en la base de datos
# cuando se configura desde el panel de admin.
# 
# Para desarrollo, puedes usar servicios como Mailtrap o MailHog.
# Para producción, configura un servidor SMTP real.
# ============================================

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@vault.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"