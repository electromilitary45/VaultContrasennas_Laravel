---
const steps = [
  {
    step: 1,
    title: 'Fork el proyecto',
    command: 'fork',
  },
  {
    step: 2,
    title: 'Crea una rama',
    command: 'git checkout -b feature/AmazingFeature',
  },
  {
    step: 3,
    title: 'Commit tus cambios',
    command: "git commit -m 'Add some AmazingFeature'",
  },
  {
    step: 4,
    title: 'Push a la rama',
    command: 'git push origin feature/AmazingFeature',
  },
  {
    step: 5,
    title: 'Abre un Pull Request',
    command: 'pr',
  },
];
---

<section class="py-24 px-6">
  <div class="max-w-4xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="gradient-text">Contribuir</span> al proyecto
      </h2>
      <p class="text-lg text-slate-600 dark:text-slate-400">
        Las contribuciones son bienvenidas. Sigue estos pasos para empezar.
      </p>
    </div>

    <!-- Steps -->
    <div class="flex flex-col md:flex-row gap-4">
      {steps.map((step) => (
        <div class="flex-1 p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/50 dark:border-slate-800/50 text-center">
          <div class="w-10 h-10 rounded-full bg-brand-500 text-white flex items-center justify-center text-sm font-bold mx-auto mb-4">
            {step.step}
          </div>
          <h3 class="font-medium mb-2">{step.title}</h3>
          {step.command !== 'fork' && step.command !== 'pr' ? (
            <code class="text-xs text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-500/10 px-2 py-1 rounded">
              {step.command}
            </code>
          ) : (
            <span class="text-xs text-slate-500 dark:text-slate-500">
              {step.command === 'fork' ? 'En GitHub' : 'En GitHub'}
            </span>
          )}
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a
        href="https://github.com/electromilitary45/VaultContrasennas_Laravel"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-medium rounded-xl hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Ver en GitHub
      </a>
    </div>
  </div>
</section>
