---
const features = [
  {
    icon: 'shield',
    title: 'AES-256 Encryption',
    description: 'Todos los secretos se almacenan cifrados en la base de datos usando AES-256-CBC con HMAC.',
    color: 'from-blue-500 to-cyan-500',
  },
  {
    icon: 'key',
    title: 'TOTP/2FA',
    description: 'Generación y gestión de códigos de autenticación de dos factores con QR codes.',
    color: 'from-purple-500 to-pink-500',
  },
  {
    icon: 'users',
    title: 'Sharing',
    description: 'Comparte items con usuarios individuales o grupos completos con permisos granulares.',
    color: 'from-green-500 to-emerald-500',
  },
  {
    icon: 'folder',
    title: 'Groups',
    description: 'Crea grupos para colaborar con equipos. Roles: owner, admin, member, viewer.',
    color: 'from-orange-500 to-amber-500',
  },
  {
    icon: 'layers',
    title: 'Folders',
    description: 'Organiza tus items en carpetas jerárquicas de hasta 5 niveles, personales o de grupo.',
    color: 'from-pink-500 to-rose-500',
  },
  {
    icon: 'clipboard',
    title: 'Audit Logs',
    description: 'Registro completo de acciones con filtros, exportación CSV y scope por organización.',
    color: 'from-teal-500 to-cyan-500',
  },
  {
    icon: 'building',
    title: 'SaaS Multi-Tenant',
    description: 'Organizaciones aisladas, códigos de invitación, panel de administración completo.',
    color: 'from-indigo-500 to-violet-500',
  },
  {
    icon: 'zap',
    title: 'Real-time',
    description: 'Notificaciones en tiempo real con WebSockets (Laravel Reverb). Invitaciones, compartición y más.',
    color: 'from-yellow-500 to-orange-500',
  },
];
---

<section id="features" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        Todo lo que necesitas para
        <span class="gradient-text">gestionar contraseñas</span>
      </h2>
      <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        PassVault incluye todas las funcionalidades que necesitas para mantener tus credenciales seguras y organizadas.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <div class="group p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/50 dark:border-slate-800/50 card-hover">
          <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${feature.color} flex items-center justify-center mb-4 group-hover:scale-110 transition-transform`}>
            {feature.icon === 'shield' && (
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {feature.icon === 'key' && (
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
              </svg>
            )}
            {feature.icon === 'users' && (
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            )}
            {feature.icon === 'folder' && (
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            )}
            {feature.icon === 'layers' && (
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            )}
            {feature.icon === 'clipboard' && (
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
            )}
            {feature.icon === 'building' && (
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            )}
            {feature.icon === 'zap' && (
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
          </div>
          <h3 class="font-semibold text-lg mb-2">{feature.title}</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
