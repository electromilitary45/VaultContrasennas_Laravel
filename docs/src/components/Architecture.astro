---
const services = [
  { name: 'VaultService', description: 'CRUD items, filtrado, cifrado', color: 'from-blue-500 to-cyan-500' },
  { name: 'CryptoService', description: 'AES-256-CBC encrypt/decrypt', color: 'from-purple-500 to-pink-500' },
  { name: 'ShareService', description: 'Compartición usuarios y grupos', color: 'from-green-500 to-emerald-500' },
  { name: 'FolderService', description: 'Carpetas jerárquicas', color: 'from-orange-500 to-amber-500' },
  { name: 'TotpService', description: 'Generación TOTP/2FA', color: 'from-pink-500 to-rose-500' },
];

const models = [
  'VaultItem',
  'Group',
  'Folder',
  'ItemShareUser',
  'ItemShareGroup',
];
---

<section id="architecture" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="gradient-text">Arquitectura</span> del sistema
      </h2>
      <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        Service Layer para separar la lógica de negocio de los controladores.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Services -->
      <div class="space-y-4">
        <h3 class="text-xl font-semibold mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Services
        </h3>

        {services.map((service) => (
          <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/50 dark:border-slate-800/50">
            <div class={`w-10 h-10 rounded-lg bg-gradient-to-br ${service.color} flex items-center justify-center flex-shrink-0`}>
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
              </svg>
            </div>
            <div>
              <h4 class="font-medium">{service.name}</h4>
              <p class="text-sm text-slate-500 dark:text-slate-500">{service.description}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Models & Policies -->
      <div class="space-y-8">
        <!-- Models -->
        <div>
          <h3 class="text-xl font-semibold mb-6 flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
            </svg>
            Models
          </h3>

          <div class="flex flex-wrap gap-3">
            {models.map((model) => (
              <div class="px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-mono text-sm">
                {model}
              </div>
            ))}
          </div>
        </div>

        <!-- Policies -->
        <div>
          <h3 class="text-xl font-semibold mb-6 flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Authorization
          </h3>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/50 dark:border-slate-800/50">
            <div class="font-mono text-sm mb-3">VaultItemPolicy</div>
            <div class="flex flex-wrap gap-2">
              {['view', 'edit', 'admin', 'owner'].map((perm) => (
                <span class="px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 text-xs font-medium border border-brand-200 dark:border-brand-500/20">
                  {perm}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
